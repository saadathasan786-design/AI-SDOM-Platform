# Copy this file to .env and fill in your details.

# Base URL of the WordPress site (Local by Flywheel site URL, e.g. https://mysite.local)
WP_BASE_URL=https://mysite.local

# WordPress username (an Administrator account)
WP_USERNAME=admin

# WordPress Application Password (Users > Profile > Application Passwords)
# NOT your normal login password. Generate one per site/tool.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Local by Flywheel sites use a self-signed SSL cert. Set to "true" to allow it locally.
# NEVER set this to true against a real/live site.
WP_ALLOW_SELF_SIGNED=true
